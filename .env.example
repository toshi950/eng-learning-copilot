# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=

# Optional. Absolute path to a directory (e.g. inside your Obsidian vault)
# where generated reading-material .md files are saved. If unset, output
# only goes to stdout.
READING_MATERIAL_OUTPUT_DIR=

# Required for Phase 2 (text-to-speech, Google Cloud Text-to-Speech).
# Absolute path to a GCP service account JSON key file. Keep the key itself
# under credentials/ (gitignored) — never commit it.
GOOGLE_APPLICATION_CREDENTIALS=

# Optional, for Phase 3 (domain-specific sourcing). Extra RSS feed URLs to
# search alongside the built-in ones in sourcing/feeds.py — comma- or
# newline-separated. Google Alerts can emit an RSS feed per alert, so this is
# where your own alerts go (keeping personal queries out of the repo).
SOURCING_EXTRA_FEEDS=

# Required for Phase 5 (vocab deck automation). The Google Sheet ID that
# collects Google Form responses (word/idiom + the sentence it appeared in).
# Share the sheet with the GOOGLE_APPLICATION_CREDENTIALS service account
# email as a Viewer, and enable the Sheets API on the same GCP project used
# for Phase 2 (Text-to-Speech) — it is a separate API to enable.
VOCAB_SHEET_ID=

# Optional, for Phase 5. AnkiConnect's local HTTP endpoint. Only needed if
# you changed AnkiConnect's default port. Requires Anki to be running with
# the AnkiConnect add-on (code 2055492159) installed.
ANKI_CONNECT_URL=http://127.0.0.1:8765

# Optional, for Phase 5. Anki deck name the generated cards are added to
# (created automatically if it doesn't exist). Shared with Phase 6 unless
# CONVERSATION_DECK_NAME below is set separately.
ANKI_DECK_NAME=English::Vocab

# Required for Phase 6 (conversation feedback). The Google Sheet ID that
# collects a separate Google Form's responses — a pasted full transcript of
# an English conversation (e.g. from Gemini Live), one per row. Share it with
# the same service account as VOCAB_SHEET_ID above.
CONVERSATION_SHEET_ID=

# Optional, for Phase 6. Max number of improved-phrase cards to extract per
# conversation transcript. The analysis won't pad up to this count if fewer
# genuine mistakes are found.
CONVERSATION_MAX_PHRASES=5
