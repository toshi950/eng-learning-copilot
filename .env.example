# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit real secrets.

ANTHROPIC_API_KEY=

# Optional. Absolute path to a directory (e.g. inside your Obsidian vault)
# where generated reading-material .md files are saved. If unset, output
# only goes to stdout.
READING_MATERIAL_OUTPUT_DIR=

# Required for Phase 2 (text-to-speech, Google Cloud Text-to-Speech).
# Absolute path to a GCP service account JSON key file. Keep the key itself
# under credentials/ (gitignored) — never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
